import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Launcher } from "./pages/launcher.slint";
import { Settings } from "./pages/settings.slint";
import { MicrosoftLogin } from "./pages/microsoft-login.slint";
import { Login } from "./pages/login.slint";
import { GameDownloadPage } from "./pages/game-download.slint";
import { GameVersionChoosePage, VersionGroup, VersionItem } from "./pages/game-version-choose.slint";
import { SearchPage, ModItem } from "./pages/mod-search.slint";
import { ChooseJarPage, ModFileItem } from "./pages/mod-choosejar.slint";
import { JavaChoosePage, JavaItem } from "./pages/java-choose.slint";
import { GameFolderManagerPage, DirItem } from "./pages/dir-choose.slint";
import { ProgressBar } from "./download-bar.slint";
import { Header } from "header.slint";

export component AppWindow inherits Window {
    preferred-width: 380px;
    preferred-height: 540px;
    in-out property <int> page-index: 0;
    in-out property <string> download-task-name: "";
    in-out property <float> download-progress: 0.0;
    in-out property <bool> progress-visible: false;

    in-out property <string> game-minecraft-path: "";
    in-out property <string> game-java-path: "";
    in-out property <int> download-source-index: 0;
    in-out property <int> download-parallel-amount: 64;
    in-out property <bool> download-verify-data: false;
    in-out property <string> download-curseforge-api-key: "";
    in-out property <int> launch-max-mem: 0;
    in-out property <bool> launch-game-independent: true;
    in-out property <bool> launch-recheck: true;
    in-out property <string> launch-jvm-args: "";
    in-out property <string> launch-game-args: "";
    in-out property <string> launch-window-title: "";
    in-out property <string> launch-wrapper-path: "";
    in-out property <string> launch-wrapper-args: "";
    in-out property <int> appearance-language-index: 0;
    in-out property <bool> appearance-auto-check-update: true;
    in-out property <string> auth-microsoft-verification-uri: "";
    in-out property <string> auth-microsoft-user-code: "";
    in-out property <string> auth-microsoft-message: "";
    in-out property <string> auth-microsoft-status: "正在获取认证码...";
    in-out property <bool> auth-microsoft-login-in-progress: false;
    in-out property <bool> auth-microsoft-can-complete-login: false;
    in-out property <string> auth-microsoft-device-code: "";
    in-out property <int> current-account-index: 0;
    in-out property <int> account-count: 0;
    in-out property <string> player-name: "Player";
    in-out property <int> login-method-type: 0;
    in-out property <image> avatar-image: @image-url("../assets/icon-player-avatar.svg");
    in-out property <[string]> instance-model: [];
    in-out property <int> selected-instance-index: -1;

    in-out property <int> login-selected-method: 0;
    in-out property <string> login-ext-auth-server: "";
    in-out property <string> login-ext-email: "";
    in-out property <string> login-ext-password: "";
    in-out property <string> login-offline-username: "Player";
    in-out property <string> login-status: "";
    in-out property <bool> login-in-progress: false;

    in-out property <string> dl-version-name: "";
    in-out property <string> dl-vanilla-selected: "";
    in-out property <string> dl-forge-selected: "";
    in-out property <string> dl-neoforge-selected: "";
    in-out property <string> dl-fabric-selected: "";
    in-out property <string> dl-quilt-selected: "";
    in-out property <string> dl-optifine-selected: "";

    in-out property <string> vc-page-title: "选择版本";
    in-out property <bool> vc-show-skip-option: false;
    in-out property <string> vc-component-type: "";
    in-out property <[VersionGroup]> vc-groups: [];
    in-out property <string> vc-selected-id: "";

    in-out property <string> mod-search-query: "";
    in-out property <int> mod-search-source-index: 0;
    in-out property <[ModItem]> mod-search-results: [];
    in-out property <bool> mod-search-is-searching: false;

    in-out property <string> mod-detail-title: "";
    in-out property <string> mod-detail-description: "";
    in-out property <[ModFileItem]> mod-detail-files: [];
    in-out property <int> mod-detail-loader-filter-index: 0;
    in-out property <int> mod-detail-mc-version-filter-index: 0;
    in-out property <[string]> mod-detail-loader-filter-model: [];
    in-out property <[string]> mod-detail-mc-version-filter-model: [];

    in-out property <[JavaItem]> java-list: [];
    in-out property <int> java-selected-index: -1;
    in-out property <bool> java-is-searching: false;

    in-out property <[DirItem]> dir-list: [];
    in-out property <int> dir-selected-index: -1;

    callback launch-game();
    callback manage-instances();
    callback open-download();
    callback open-settings();
    callback instance-selected(value: string);
    callback go-back();
    callback config-changed();
    callback open-microsoft-login();
    callback start-microsoft-login();
    callback complete-microsoft-login();
    callback open-login();
    callback select-microsoft-login();
    callback start-external-login(server: string, email: string, password: string);
    callback start-offline-login(username: string);
    callback account-switched(index: int);

    callback install-game();
    callback component-clicked(component-type: string);

    callback version-choose-selected(id: string);
    callback toggle-group(index: int);

    callback search-mods();
    callback mod-selected(project_id: string);
    callback mod-download-file(index: int);
    callback mod-filter-changed();

    callback search-java();
    callback java-selected(index: int);
    callback add-java-path();

    callback add-dir();
    callback remove-dir(index: int);
    callback dir-selected(index: int);

    VerticalLayout {
        if page-index != 0:
        Header {
            go-back => { root.go-back(); }
        }

        Rectangle {
            vertical-stretch: 1;

            if page-index == 0: Launcher {
                current-account-index <=> root.current-account-index;
                account-count <=> root.account-count;
                player-name <=> root.player-name;
                login-method-type <=> root.login-method-type;
                avatar-image <=> root.avatar-image;
                instance-model <=> root.instance-model;
                selected-instance-index <=> root.selected-instance-index;
                launch-game => { root.launch-game(); }
                manage-instances => { root.manage-instances(); }
                open-download => { root.open-download(); }
                open-settings => { root.open-settings(); }
                instance-selected(value) => { root.instance-selected(value); }
                account-switched(index) => { root.account-switched(index); }
                open-login => { root.open-login(); }
            }
            if page-index == 2: Login {
                selected-method <=> root.login-selected-method;
                ext-auth-server <=> root.login-ext-auth-server;
                ext-email <=> root.login-ext-email;
                ext-password <=> root.login-ext-password;
                offline-username <=> root.login-offline-username;
                login-status <=> root.login-status;
                login-in-progress <=> root.login-in-progress;
                open-microsoft-login => { root.open-microsoft-login(); }
                start-external-login(server, email, password) => { root.start-external-login(server, email, password); }
                start-offline-login(username) => { root.start-offline-login(username); }
            }
            if page-index == 3: Settings {
                game-minecraft-path <=> root.game-minecraft-path;
                game-java-path <=> root.game-java-path;
                download-source-index <=> root.download-source-index;
                download-parallel-amount <=> root.download-parallel-amount;
                download-verify-data <=> root.download-verify-data;
                download-curseforge-api-key <=> root.download-curseforge-api-key;
                launch-max-mem <=> root.launch-max-mem;
                launch-game-independent <=> root.launch-game-independent;
                launch-recheck <=> root.launch-recheck;
                launch-jvm-args <=> root.launch-jvm-args;
                launch-game-args <=> root.launch-game-args;
                launch-window-title <=> root.launch-window-title;
                launch-wrapper-path <=> root.launch-wrapper-path;
                launch-wrapper-args <=> root.launch-wrapper-args;
                appearance-language-index <=> root.appearance-language-index;
                appearance-auto-check-update <=> root.appearance-auto-check-update;

                config-changed => { root.config-changed(); }
                open-microsoft-login => { root.open-microsoft-login(); }
            }
            if page-index == 4: MicrosoftLogin {
                verification-uri <=> root.auth-microsoft-verification-uri;
                user-code <=> root.auth-microsoft-user-code;
                message <=> root.auth-microsoft-message;
                status-text <=> root.auth-microsoft-status;
                login-in-progress <=> root.auth-microsoft-login-in-progress;
                can-complete-login <=> root.auth-microsoft-can-complete-login;

                start-microsoft-login => { root.start-microsoft-login(); }
                complete-microsoft-login => { root.complete-microsoft-login(); }
            }
            if page-index == 5: GameDownloadPage {
                version-name <=> root.dl-version-name;
                vanilla-selected <=> root.dl-vanilla-selected;
                forge-selected <=> root.dl-forge-selected;
                neoforge-selected <=> root.dl-neoforge-selected;
                fabric-selected <=> root.dl-fabric-selected;
                quilt-selected <=> root.dl-quilt-selected;
                optifine-selected <=> root.dl-optifine-selected;

                install-game => { root.install-game(); }
                component-clicked(ct) => { root.component-clicked(ct); }
            }
            if page-index == 6: GameVersionChoosePage {
                page-title <=> root.vc-page-title;
                show-skip-option <=> root.vc-show-skip-option;
                groups <=> root.vc-groups;
                selected-version-id <=> root.vc-selected-id;
                version-selected(id) => { root.version-choose-selected(id); }
                toggle-group(index) => { root.toggle-group(index); }
            }
            if page-index == 7: SearchPage {
                search-query <=> root.mod-search-query;
                search-source-index <=> root.mod-search-source-index;
                mod-results <=> root.mod-search-results;
                is-searching <=> root.mod-search-is-searching;
                search-mods => { root.search-mods(); }
                mod-selected(pid) => { root.mod-selected(pid); }
            }
            if page-index == 8: ChooseJarPage {
                mod-title <=> root.mod-detail-title;
                mod-description <=> root.mod-detail-description;
                mod-files <=> root.mod-detail-files;
                loader-filter-index <=> root.mod-detail-loader-filter-index;
                mc-version-filter-index <=> root.mod-detail-mc-version-filter-index;
                loader-filter-model <=> root.mod-detail-loader-filter-model;
                mc-version-filter-model <=> root.mod-detail-mc-version-filter-model;
                download-file(idx) => { root.mod-download-file(idx); }
                filter-changed => { root.mod-filter-changed(); }
            }
            if page-index == 9: JavaChoosePage {
                java-list <=> root.java-list;
                selected-java-index <=> root.java-selected-index;
                is-searching <=> root.java-is-searching;
                search-java => { root.search-java(); }
                java-selected(idx) => { root.java-selected(idx); }
                add-java-path => { root.add-java-path(); }
            }
            if page-index == 11: GameFolderManagerPage {
                dir-list <=> root.dir-list;
                selected-dir-index <=> root.dir-selected-index;
                add-dir => { root.add-dir(); }
                remove-dir(idx) => { root.remove-dir(idx); }
                dir-selected(idx) => { root.dir-selected(idx); }
            }
        }

        if root.progress-visible: ProgressBar {
            task-name: download-task-name;
            progress: download-progress;
            dismiss => { root.progress-visible = false; }
        }
    }
}
