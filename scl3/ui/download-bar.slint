import { Palette, StyleMetrics, ProgressIndicator } from "std-widgets.slint";

export component ProgressBar inherits Rectangle {
    in-out property <string> task-name: "正在安装 Minecraft 1.16.5";
    in-out property <float> progress: 0.50;

    callback dismiss();

    background: Palette.background;
    height: layout.preferred-height;

    layout := VerticalLayout {

        padding-left: StyleMetrics.layout-padding;
        padding-right: StyleMetrics.layout-padding;

        padding-bottom: StyleMetrics.layout-padding;
        spacing: StyleMetrics.layout-spacing;

        HorizontalLayout {
            Text {
                text: root.task-name;
                font-size: 1.1rem;
                color: Palette.foreground;
            }

            Rectangle {}

            close-area := TouchArea {
                width: close-label.preferred-width + 16px;
                height: close-label.preferred-height + 8px;

                Rectangle {
                    background: close-area.has-hover ? #e0e0e0 : transparent;
                    border-radius: 4px;

                    close-label := Text {
                        text: "✕";
                        font-size: 1rem;
                        color: Palette.foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                clicked => {
                    root.dismiss();
                }
            }
        }

        ProgressIndicator {
            progress: root.progress;
        }
    }
}
