import { LineEdit, Palette, StyleMetrics } from "std-widgets.slint";
import { PageContainer } from "../base/page-container.slint";

component ComponentRow inherits Rectangle {
    in property <string> icon;
    in property <color> icon_color;
    in property <string> name;
    in property <string> selected-text: "";
    callback clicked;

    height: 38px;
    background: transparent;

    TouchArea {
        clicked => { root.clicked(); }

        HorizontalLayout {
            spacing: StyleMetrics.layout-spacing;
            alignment: start;

            Text {
                text: root.icon;
                font-size: 1.5rem;
                color: root.icon_color;
                vertical-alignment: center;
            }

            Text {
                text: root.name;
                font-size: 1.25rem;
                color: Palette.foreground;
                vertical-alignment: center;
                min-width: 90px;
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: root.selected-text != "" ? root.selected-text : "未选择";
                font-size: 1rem;
                color: root.selected-text != "" ? Palette.foreground : Palette.alternate-foreground;
                vertical-alignment: center;
            }

            Text {
                text: "›";
                font-size: 1.25rem;
                color: Palette.alternate-foreground;
                vertical-alignment: center;
            }
        }
    }
}

export component GameDownloadPage inherits PageContainer {
    width: 350px;
    height: 440px;

    in-out property <string> version-name: "";

    in property <string> vanilla-selected: "";
    in property <string> forge-selected: "";
    in property <string> neoforge-selected: "";
    in property <string> fabric-selected: "";
    in property <string> quilt-selected: "";
    in property <string> optifine-selected: "";

    callback install-game();
    callback component-clicked(component-type: string);

    Text {
        text: "游戏版本名称";
        font-size: 1.17rem;
        color: Palette.foreground;
    }

    Rectangle {
        height: 36px;

        LineEdit {
            text: root.version-name;
            font-size: 1.25rem;
            height: 36px;
            edited(val) => {
                root.version-name = val;
            }
        }
    }

    Rectangle { height: 6px; }

    Text {
        text: "游戏组件";
        font-size: 1.17rem;
        color: Palette.foreground;
    }

    VerticalLayout {
        spacing: StyleMetrics.layout-spacing;

        ComponentRow {
            icon: "🟩";
            icon_color: #7fa645;
            name: "Minecraft";
            selected-text: root.vanilla-selected;
            clicked => { root.component-clicked("vanilla"); }
        }

        ComponentRow {
            icon: "⚒️";
            icon_color: #707070;
            name: "Forge";
            selected-text: root.forge-selected;
            clicked => { root.component-clicked("forge"); }
        }

        ComponentRow {
            icon: "🔥";
            icon_color: #e65100;
            name: "NeoForge";
            selected-text: root.neoforge-selected;
            clicked => { root.component-clicked("neoforge"); }
        }

        ComponentRow {
            icon: "🧵";
            icon_color: #d7ccc8;
            name: "Fabric";
            selected-text: root.fabric-selected;
            clicked => { root.component-clicked("fabric"); }
        }

        ComponentRow {
            icon: "🔮";
            icon_color: #7b1fa2;
            name: "QuiltMC";
            selected-text: root.quilt-selected;
            clicked => { root.component-clicked("quilt"); }
        }

        ComponentRow {
            icon: "👓";
            icon_color: #555555;
            name: "Optifine";
            selected-text: root.optifine-selected;
            clicked => { root.component-clicked("optifine"); }
        }
    }

    Rectangle { min-height: 10px; }

    Rectangle {
        background: Palette.accent-background;
        border-radius: 6px;
        height: 42px;

        Text {
            text: "安装游戏";
            color: Palette.accent-foreground;
            font-size: 1.33rem;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => {
                root.install-game();
            }
        }
    }
}
