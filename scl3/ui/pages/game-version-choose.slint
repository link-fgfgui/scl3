import { ScrollView, Palette, StyleMetrics } from "std-widgets.slint";

export struct VersionItem {
    id: string,
    text: string,
}

export struct VersionGroup {
    title: string,
    items: [VersionItem],
    expanded: bool,
}

component VersionRow inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> is-sub: false;
    callback clicked;

    height: 38px;
    background: transparent;

    TouchArea {
        clicked => { root.clicked(); }

        HorizontalLayout {
            padding-left: root.is-sub ? 42px : StyleMetrics.layout-padding;
            padding-right: StyleMetrics.layout-padding;
            alignment: space-between;

            HorizontalLayout {
                spacing: StyleMetrics.layout-spacing;
                alignment: start;

                Text {
                    text: "📜";
                    font-size: 1.25rem;
                    vertical-alignment: center;
                }

                Text {
                    text: root.text;
                    font-size: 1.17rem;
                    color: Palette.foreground;
                    vertical-alignment: center;
                }
            }

            if (root.selected) : Rectangle {
                width: 10px;
                height: 10px;
                background: Palette.foreground;
                border-radius: 5px;
                y: (parent.height - self.height) / 2;
            }
        }
    }
}

component ExpandableHeader inherits Rectangle {
    in property <string> text;
    in property <bool> expanded: false;
    callback clicked;

    height: 38px;
    background: transparent;

    TouchArea {
        clicked => { root.clicked(); }

        HorizontalLayout {
            padding-left: StyleMetrics.layout-padding;
            padding-right: StyleMetrics.layout-padding;
            spacing: StyleMetrics.layout-spacing;
            alignment: start;

            Text {
                text: root.expanded ? "⌃" : "⌄";
                font-size: 1.17rem;
                color: Palette.alternate-foreground;
                vertical-alignment: center;
                width: 14px;
            }

            Text {
                text: root.text;
                font-size: 1.17rem;
                color: Palette.foreground;
                vertical-alignment: center;
            }
        }
    }
}

export component GameVersionChoosePage inherits Rectangle {
    width: 340px;
    height: 450px;
    background: Palette.background;

    in property <string> page-title: "选择版本";
    in property <bool> show-skip-option: false;
    in-out property <[VersionGroup]> groups: [];
    in-out property <string> selected-version-id: "";
    callback version-selected(id: string);
    callback toggle-group(index: int);

    VerticalLayout {
        padding: StyleMetrics.layout-padding;
        spacing: StyleMetrics.layout-spacing;

        Text {
            text: root.page-title;
            font-size: 1.25rem;
            font-weight: 700;
            color: Palette.foreground;
        }

        ScrollView {
            VerticalLayout {
                spacing: StyleMetrics.layout-spacing;
                alignment: start;

                if (root.show-skip-option) : VersionRow {
                    text: "不安装";
                    selected: root.selected-version-id == "";
                    clicked => {
                        root.selected-version-id = "";
                        root.version-selected("");
                    }
                }

                for group[gidx] in root.groups: VerticalLayout {
                    spacing: 0px;

                    ExpandableHeader {
                        text: group.title;
                        expanded: group.expanded;
                        clicked => {
                            root.toggle-group(gidx);
                        }
                    }

                    if (group.expanded) : VerticalLayout {
                        spacing: 0px;
                        for item in group.items: VersionRow {
                            text: item.text;
                            is-sub: true;
                            selected: root.selected-version-id == item.id;
                            clicked => {
                                root.selected-version-id = item.id;
                                root.version-selected(item.id);
                            }
                        }
                    }
                }
            }
        }
    }
}
