import { Button, ComboBox, ScrollView, Palette, StyleMetrics } from "std-widgets.slint";
import { PageContainer } from "../base/page-container.slint";

export struct ModFileItem {
    filename: string,
    game-versions: string,
    loaders: string,
    download-url: string,
    primary: bool,
}

component ModFileRow inherits Rectangle {
    in property <string> filename;
    in property <string> game-versions;
    in property <string> loaders;
    in property <bool> primary: false;

    callback download-clicked;

    height: 56px;
    background: touch.has-hover ? Palette.alternate-background : transparent;

    touch := TouchArea {}

    HorizontalLayout {
        padding-left: StyleMetrics.layout-padding;
        padding-right: StyleMetrics.layout-padding;
        spacing: StyleMetrics.layout-spacing;
        alignment: start;

        Rectangle {
            width: 22px;
            height: 22px;
            background: Palette.control-background;
            border-radius: 4px;
            y: (parent.height - self.height) / 2;

            Text {
                text: "🧩";
                font-size: 1rem;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Text {
                    text: root.filename;
                    font-size: 1.08rem;
                    color: Palette.foreground;
                    overflow: elide;
                }

                if (root.primary) : Rectangle {
                    background: Palette.accent-background;
                    border-radius: 3px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;

                    Text {
                        text: "主文件";
                        color: Palette.accent-foreground;
                        font-size: 0.75rem;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: root.loaders;
                    font-size: 0.92rem;
                    color: Palette.alternate-foreground;
                }

                Text {
                    text: root.game-versions;
                    font-size: 0.92rem;
                    color: Palette.alternate-foreground;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            width: 28px;

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 4px;
                background: dl-touch.has-hover ? Palette.accent-background : Palette.control-background;

                Text {
                    text: "⬇";
                    color: dl-touch.has-hover ? Palette.accent-foreground : Palette.control-foreground;
                    font-size: 1.08rem;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                dl-touch := TouchArea {
                    clicked => { root.download-clicked(); }
                }
            }
        }
    }
}

export component ChooseJarPage inherits PageContainer {
    width: 360px;
    height: 540px;

    in-out property <string> mod-title: "";
    in-out property <string> mod-description: "";
    in-out property <[ModFileItem]> mod-files: [];
    in-out property <int> loader-filter-index: 0;
    in-out property <int> mc-version-filter-index: 0;
    in-out property <[string]> loader-filter-model: [];
    in-out property <[string]> mc-version-filter-model: [];

    callback download-file(index: int);
    callback filter-changed();

    HorizontalLayout {
        spacing: StyleMetrics.layout-spacing;
        alignment: start;

        Rectangle {
            width: 46px;
            height: 46px;
            background: Palette.control-background;
            border-radius: 6px;

            Text {
                text: root.mod-title;
                color: Palette.control-foreground;
                font-size: 1.25rem;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: StyleMetrics.layout-spacing;

            Text {
                text: root.mod-title;
                font-size: 1.17rem;
                color: Palette.foreground;
                overflow: elide;
            }
            Text {
                text: root.mod-description;
                font-size: 1rem;
                color: Palette.alternate-foreground;
                overflow: elide;
            }
        }
    }

    HorizontalLayout {
        spacing: StyleMetrics.layout-spacing;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: StyleMetrics.layout-spacing;
            Text { text: "加载器"; font-size: 0.92rem; color: Palette.alternate-foreground; }
            ComboBox {
                model: root.loader-filter-model;
                current-index: root.loader-filter-index;
                selected(val) => {
                    root.loader-filter-index = self.current-index;
                    root.filter-changed();
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: StyleMetrics.layout-spacing;
            Text { text: "MC 版本"; font-size: 0.92rem; color: Palette.alternate-foreground; }
            ComboBox {
                model: root.mc-version-filter-model;
                current-index: root.mc-version-filter-index;
                selected(val) => {
                    root.mc-version-filter-index = self.current-index;
                    root.filter-changed();
                }
            }
        }
    }

    ScrollView {
        VerticalLayout {
            spacing: 0px;
            alignment: start;

            for item[idx] in root.mod-files : ModFileRow {
                filename: item.filename;
                game-versions: item.game-versions;
                loaders: item.loaders;
                primary: item.primary;
                download-clicked => {
                    root.download-file(idx);
                }
            }
        }
    }
}
