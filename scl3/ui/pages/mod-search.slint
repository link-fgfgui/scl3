import { ComboBox, LineEdit, ScrollView, Palette, StyleMetrics } from "std-widgets.slint";
import { PageContainer } from "../base/page-container.slint";

export struct ModItem {
    project_id: string,
    title: string,
    description: string,
    icon_url: string,
}

component ModListItem inherits Rectangle {
    in property <string> project_id: "";
    in property <string> title: "Mod Title";
    in property <string> description: "Mod Description";

    background: @linear-gradient(0deg, Palette.alternate-background, Palette.background);
    border-radius: 4px;
    height: 75px;

    HorizontalLayout {
        padding: StyleMetrics.layout-padding;
        spacing: StyleMetrics.layout-spacing;
        alignment: start;

        Rectangle {
            width: 58px;
            height: 58px;
            background: Palette.control-background;
            border-radius: 6px;

            Text {
                text: "🧩";
                color: Palette.control-foreground;
                font-size: 1.5rem;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: StyleMetrics.layout-spacing;

            Text {
                text: root.title;
                font-size: 1.17rem;
                color: Palette.foreground;
                overflow: elide;
            }
            Text {
                text: root.description;
                font-size: 1rem;
                color: Palette.alternate-foreground;
                overflow: elide;
            }
        }
    }

    TouchArea {
        clicked => {
            root.mod-clicked(root.project_id);
        }
    }

    callback mod-clicked(string);
}

export component SearchPage inherits PageContainer {
    width: 380px;
    height: 500px;

    in-out property <string> search-query: "";
    in-out property <int> search-source-index: 0;
    in-out property <[ModItem]> mod-results: [];
    in-out property <bool> is-searching: false;

    callback search-mods();
    callback mod-selected(string);

    HorizontalLayout {
        spacing: StyleMetrics.layout-spacing;
        height: 36px;

        ComboBox {
            width: 120px;
            model: ["Modrinth", "CurseForge"];
            current-index: root.search-source-index;
            selected(val) => {
                root.search-source-index = self.current-index;
            }
        }

        Rectangle {
            width: 36px;
            background: Palette.accent-background;
            border-radius: 4px;

            Text {
                text: "🔍";
                color: Palette.accent-foreground;
                font-size: 1.33rem;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    root.search-mods();
                }
            }
        }

        LineEdit {
            text: root.search-query;
            placeholder-text: "搜索...";
            font-size: 1.17rem;
            edited(val) => {
                root.search-query = val;
                root.search-mods();
            }
        }
    }

    if root.is-searching : Rectangle {
        height: 48px;
        background: transparent;

        HorizontalLayout {
            alignment: center;

            Text {
                text: "搜索中...";
                font-size: 1.17rem;
                color: Palette.alternate-foreground;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }

    if !root.is-searching : ScrollView {
        VerticalLayout {
            spacing: StyleMetrics.layout-spacing;
            alignment: start;

            for item in root.mod-results : ModListItem {
                project_id: item.project_id;
                title: item.title;
                description: item.description;
                mod-clicked(pid) => {
                    root.mod-selected(pid);
                }
            }
        }
    }
}
